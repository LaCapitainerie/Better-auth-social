{
  "name": "better-auth-social",
  "version": "1.4.0",
  "description": "A social network plugin for Better Auth with friends, friend requests, chat, and group chat features.",
  "author": "LaCapitainerie",
  "main": "dist/index.js",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js"
    },
    "./client": {
      "import": "./dist/client.js",
      "types": "./dist/client.d.ts",
      "require": "./dist/client.js"
    }
  },
  "scripts": {
    "ts": "tsc --noEmit",
    "build": "tsc",
    "test": "vitest",
    "test:ci": "vitest run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LaCapitainerie/Better-auth-social.git"
  },
  "keywords": [
    "better-auth",
    "auth",
    "plugin",
    "social-network",
    "friends",
    "chat",
    "group-chat",
    "messaging"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/LaCapitainerie/Better-auth-social/issues"
  },
  "homepage": "https://github.com/LaCapitainerie/Better-auth-social#readme",
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "better-auth": "^1.6.20",
    "better-sqlite3": "^12.11.1",
    "typescript": "6.0.3",
    "vitest": "^4.1.9"
  },
  "peerDependencies": {
    "better-auth": "^1.5.1"
  },
  "dependencies": {
    "@better-auth/core": "^1.6.20",
    "@hono/node-server": "^2.0.6",
    "effect": "^3.21.4",
    "hono": "^4.12.27",
    "lodash": "^4.18.1",
    "vite": "^8.0.16",
    "zod": "^4.4.3"
  }
}
