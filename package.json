{
  "name": "better-auth-social",
  "version": "1.0.0",
  "description": "A social network plugin for Better Auth with friends, friend requests, chat, and group chat features.",
  "author": "LaCapitainerie",
  "main": "dist/index.js",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js"
    },
    "./client": {
      "import": "./dist/client.js",
      "types": "./dist/client.d.ts",
      "require": "./dist/client.js"
    }
  },
  "scripts": {
    "build": "next build --turbo",
    "type:generate": "next typegen .",
    "clean": "next lint --fix && tsc --noEmit && prettier --write .",
    "dev": "next dev --turbopack",
    "format": "prettier --write .",
    "knip": "knip-bun --config knip.json",
    "lint": "eslint . --fix",
    "start": "next start",
    "ts": "tsc --noEmit",
    "test": "vitest",
    "test:ci": "vitest run",
    "lint:ci": "eslint ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LaCapitainerie/Better-auth-social.git"
  },
  "keywords": [
    "better-auth",
    "auth",
    "plugin",
    "social-network",
    "friends",
    "chat",
    "group-chat",
    "messaging"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/LaCapitainerie/Better-auth-social/issues"
  },
  "homepage": "https://github.com/LaCapitainerie/Better-auth-social#readme",
  "peerDependencies": {
    "better-auth": "^1.4.6"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "vitest": "^4.0.18"
  }
}
